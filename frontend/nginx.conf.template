# Variables substituées au démarrage par l'image nginx (envsubst) :
#   BACKEND_HOST          — hostname Docker du backend (défaut: backend)
#   BACKEND_CONTEXT_PATH  — context-path Spring (défaut: /vibe-genealogy, vide si context /)
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;

    # ^~ : priorité absolue sur les locations regex / SPA — sinon POST /auth/login
    # tombe dans try_files → 405 Method Not Allowed (page statique).
    location ^~ /vibe-genealogy/api/ {
        proxy_pass http://${BACKEND_HOST}:8080${BACKEND_CONTEXT_PATH}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /vibe-genealogy;
        client_max_body_size 50M;
    }

    location ^~ /vibe-genealogy/auth/ {
        proxy_pass http://${BACKEND_HOST}:8080${BACKEND_CONTEXT_PATH}/auth/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Prefix /vibe-genealogy;
    }

    # Fallback si l'API est appelée sans le préfixe /vibe-genealogy
    location ^~ /api/ {
        proxy_pass http://${BACKEND_HOST}:8080${BACKEND_CONTEXT_PATH}/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 50M;
    }

    location ^~ /auth/ {
        proxy_pass http://${BACKEND_HOST}:8080${BACKEND_CONTEXT_PATH}/auth/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback (les POST API ne doivent jamais arriver ici — voir ^~ ci-dessus)
    location /vibe-genealogy/ {
        rewrite ^/vibe-genealogy/(.*)$ /$1 break;
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
